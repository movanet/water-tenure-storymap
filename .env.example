# Copy this file to .env and edit it. Never commit .env.
# docker compose reads .env from the repository root.

# --- Network ------------------------------------------------------------------
# Address the published ports bind to. Keep 127.0.0.1 and put a TLS reverse
# proxy (Caddy, Nginx) in front; use 0.0.0.0 only on a trusted private network.
BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
API_PORT=8000

# --- Write access to the API -----------------------------------------------------
# Bearer token for every write (POST, PATCH, DELETE). Empty = writes disabled.
# Generate one with:  openssl rand -hex 32
TENURE_API_TOKEN=

# --- Seeding (only while the database is empty) ----------------------------------
# true = load the bundled synthetic sample (fictional Sample River Basin).
# Set it to false before you load your own records.
SEED_SAMPLE=true
# Path INSIDE the container of your own GeoJSON records, for example the output
# of tools/import_catalogue.py mounted at /seed (see docker-compose.yml).
SEED_FILE=

# --- Public output ----------------------------------------------------------------
CORS_ORIGINS=*
DATA_ATTRIBUTION=Water Tenure Storymap deployment
EXPORT_DESCRIPTION=Public-sensitivity water tenure records.
# Displacement, in metres, applied to aggregate_only records on public reads.
FUZZ_MIN_METERS=250
FUZZ_MAX_METERS=1000

# --- Photo uploads ----------------------------------------------------------------
MAX_UPLOAD_MB=15
# Re-encode stored photos without EXIF metadata (GPS, camera serial, owner).
STRIP_EXIF=true

# --- Optional AI captions (any OpenAI-compatible chat endpoint) -------------------
# Captioning stays off while VISION_API_KEY is empty. For a local server that
# needs no key (Ollama, vLLM), set any placeholder value.
VISION_API_KEY=
VISION_API_URL=https://api.openai.com/v1/chat/completions
VISION_MODEL=gpt-4o-mini
